{
  "$schema":
    "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "serviceBusNamespaceName": {
      "type": "string",
      "minLength": 6,
      "maxLength": 50,
      "metadata": {
        "description": "New unique namespace name in a disposable resource group. Verify that this namespace does not already exist before deployment."
      }
    }
  },
  "variables": {
    "apiVersion": "2024-01-01",
    "rulesTopicName": "TopicFilterSampleTopic",
	"basicqueuename": "basicqueue",
	"dedupqueuename": "dupdetectqueue",
	"basictopicname": "basictopic",
	"autofwdtopicname": "autoforwardsourcetopic",
	"autofwdtargetqueuename":"autoforwardtargetqueue",
	"partitionedqueuename" : "partitionedqueue"
  },
  "resources": [
      {
      "apiVersion": "[variables('apiVersion')]",
      "name": "[parameters('serviceBusNamespaceName')]",
      "type": "Microsoft.ServiceBus/namespaces",
      "location": "[resourceGroup().location]",
      "sku": { "name": "Standard", "tier": "Standard" },
      "properties": { "minimumTlsVersion": "1.2" },
      "resources": [
        {
          "type": "AuthorizationRules",
          "name": "SendListen",
          "apiVersion": "[variables('apiVersion')]",
          "scale": null,
          "properties": {
            "rights": ["Listen", "Send"]
          },
          "dependsOn": [
            "[parameters('serviceBusNamespaceName')]"
          ]
        },        
		{
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('basicqueuename')]",
          "type": "queues",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]"
          ],
          "properties": {},
          "resources": []
        }, 
		{
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('dedupqueuename')]",
          "type": "queues",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]"
          ],
          "properties": {
				"requiresDuplicateDetection": true,
				 "duplicateDetectionHistoryTimeWindow": "PT5M"
			},
          "resources": []
        },
        {
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('rulesTopicName')]",
          "type": "topics",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]"
          ],
          "properties": {},
          "resources": [
            {
              "apiVersion": "[variables('apiVersion')]",
              "name": "allorders",
              "type": "subscriptions",
              "dependsOn": ["[variables('rulesTopicName')]"],
              "properties": {},
              "resources": [
				{
					"apiVersion": "[variables('apiVersion')]",
					"name": "AllOrdersRule",
					"type": "rules",
					"dependsOn": [ "allorders" ],
					"properties": {
						"filterType": "SqlFilter",
						"sqlFilter": {
						   "sqlExpression": "1=1"
						}
					}
				}
			  ]
            },
            {
              "apiVersion": "[variables('apiVersion')]",
              "name": "ColorBlueSize10Orders",
              "type": "subscriptions",
              "dependsOn": ["[variables('rulesTopicName')]"],
              "properties": {},
              "resources": [
					{
					"apiVersion": "[variables('apiVersion')]",
					"name": "ColorBlueSize10OrdersRule",
					"type": "rules",
					"dependsOn": [ "ColorBlueSize10Orders" ],
					"properties": {
					"filterType": "SqlFilter",
					   "sqlFilter": {
						  "sqlExpression": "color = 'blue' AND quantity = 10"
					   }
					}
				 }
			  ]
            },
            {
              "apiVersion": "[variables('apiVersion')]",
              "name": "ColorRed",
              "type": "subscriptions",
              "dependsOn": ["[variables('rulesTopicName')]"],
              "properties": {},
              "resources": [
					{
						"apiVersion": "[variables('apiVersion')]",
						"name": "ColorRedRule",
						"type": "rules",
						"dependsOn": [ "ColorRed" ],
						"properties": {
						"filterType": "SqlFilter",
						   "sqlFilter": {
							  "sqlExpression": "color = 'red'"
						   },
						   "action": {
							  "sqlExpression": "SET quantity = quantity / 2; REMOVE priority; SET sys.CorrelationId = 'low';"
						   }
					}
				 }
			  ]
            },
            {
              "apiVersion": "[variables('apiVersion')]",
              "name": "HighPriorityOrders",
              "type": "subscriptions",
              "dependsOn": ["[variables('rulesTopicName')]"],
              "properties": {},
              "resources": [
				{
					"apiVersion": "[variables('apiVersion')]",
					"name": "HighPriorityOrdersRule",
					"type": "rules",
					"dependsOn": [ "HighPriorityOrders" ],
					"properties": {
						"filterType": "CorrelationFilter",
						"correlationFilter": {
							"label": "red",
							"correlationId": "high"
						}
					}
				}
				]
            }
          ]
        },
		{
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('basictopicname')]",
          "type": "topics",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]"
          ],
          "properties": {},
          "resources": [
            {
              "apiVersion": "[variables('apiVersion')]",
              "name": "subscription1",
              "type": "subscriptions",
              "dependsOn": ["[variables('basictopicname')]"],
              "properties": {},
              "resources": []
            },
			{
              "apiVersion": "[variables('apiVersion')]",
              "name": "subscription2",
              "type": "subscriptions",
              "dependsOn": ["[variables('basictopicname')]"],
              "properties": {},
              "resources": []
            },
			{
              "apiVersion": "[variables('apiVersion')]",
              "name": "subscription3",
              "type": "subscriptions",
              "dependsOn": ["[variables('basictopicname')]"],
              "properties": {},
              "resources": []
            }
          ]
        },
		{
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('autofwdtargetqueuename')]",
          "type": "queues",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]"
          ],
          "properties": {},
          "resources": []
        },
		{
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('autofwdtopicname')]",
          "type": "topics",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]",
			"[variables('autofwdtargetqueuename')]"
          ],
          "properties": {},
          "resources": [
            {
              "apiVersion": "[variables('apiVersion')]",
              "name": "forwarder",
              "type": "subscriptions",
              "dependsOn": ["[variables('autofwdtopicname')]"],
              "properties": {
					"forwardTo": "[variables('autofwdtargetqueuename')]"
				},
              "resources": []
            }
          ]
        },		
		{
          "apiVersion": "[variables('apiVersion')]",
          "name": "[variables('partitionedqueuename')]",
          "type": "queues",
          "dependsOn": [
            "[concat('Microsoft.ServiceBus/namespaces/', parameters('serviceBusNamespaceName'))]"
          ],
          "properties": {
				"enablePartitioning" : true
			},
          "resources": []
        }
      ]
    }
  ],
  "outputs": {
    "serviceBusNamespaceName" : {
      "type" : "string",
      "value" : "[parameters('serviceBusNamespaceName')]"
    }
  }
}
